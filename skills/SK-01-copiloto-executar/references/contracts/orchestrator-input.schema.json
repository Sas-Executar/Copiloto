{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestrator-input.schema.json",
  "title": "Entrada do Orquestrador do Copiloto",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "command",
    "timestamp",
    "source"
  ],
  "properties": {
    "command": {
      "type": "string",
      "enum": [
        "/bomdia",
        "/agora",
        "/estado",
        "/fechardia",
        "/replanejamento",
        "/mapa",
        "/evidencia",
        "/bloqueio",
        "/atualizar",
        "/contexto",
        "/capacidade",
        "/mudanca",
        "/processo",
        "/procedimento",
        "/risco",
        "/conformidade"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "enum": [
        "humano",
        "sistema"
      ]
    },
    "message": {
      "type": "string"
    },
    "object_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "result": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "blocker": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "blocking": {
          "type": "boolean"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "description",
        "blocking"
      ]
    },
    "requested_scope": {
      "type": "string",
      "enum": [
        "minimo",
        "normal",
        "abrangente"
      ],
      "default": "minimo"
    }
  }
}