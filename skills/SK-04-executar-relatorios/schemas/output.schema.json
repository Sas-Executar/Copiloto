{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:executar-mapa-os:output:v1",
  "title": "EXECUTAR Mapa-OS Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["document", "project", "position", "three_p_n", "items", "evidence", "horizons", "next_action", "issues", "validation"],
  "$defs": {
    "nullableId": {"type": ["string", "null"]},
    "state": {
      "type": "string",
      "enum": ["not_started", "eligible", "active", "blocked", "existing", "complete", "approved", "implemented", "tested", "verified", "published", "cancelled", "NAO_DETERMINADO"]
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue_id", "type", "description", "severity"],
      "properties": {
        "issue_id": {"type": "string"},
        "type": {"type": "string", "enum": ["blocker", "conflict", "gap", "overflow", "authority"]},
        "description": {"type": "string"},
        "severity": {"type": "string", "enum": ["info", "warning", "blocking"]},
        "source_refs": {"type": "array", "items": {"type": "string"}},
        "resolution": {"type": ["string", "null"]}
      }
    }
  },
  "properties": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "generated_at", "source_refs"],
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "string"},
        "generated_at": {"type": "string", "format": "date-time"},
        "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "state"],
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "state": {"$ref": "#/$defs/state"},
        "owner": {"type": ["string", "null"]}
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "project_id", "delivery_id", "workflow_id", "action_id"],
      "properties": {
        "mode": {"type": "string", "enum": ["MAPA", "EXECUTAR"]},
        "project_id": {"type": "string"},
        "delivery_id": {"$ref": "#/$defs/nullableId"},
        "workflow_id": {"$ref": "#/$defs/nullableId"},
        "action_id": {"$ref": "#/$defs/nullableId"}
      }
    },
    "three_p_n": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problem", "process", "progress", "next"],
      "properties": {
        "problem": {"type": "string"},
        "process": {"type": "string"},
        "progress": {"type": "string"},
        "next": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string"}}
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "level", "title", "state", "parent_id", "dependencies", "evidence_refs", "source_refs"],
        "properties": {
          "id": {"type": "string"},
          "level": {"type": "string", "enum": ["project", "delivery", "workflow", "action"]},
          "title": {"type": "string"},
          "state": {"$ref": "#/$defs/state"},
          "parent_id": {"$ref": "#/$defs/nullableId"},
          "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "blocked": {"type": "boolean", "default": false},
          "completion_criterion": {"type": ["string", "null"]},
          "original_due": {"type": ["string", "null"]},
          "current_forecast": {"type": ["string", "null"]},
          "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "epistemic_class", "description", "source_ref", "supports"],
        "properties": {
          "evidence_id": {"type": "string"},
          "epistemic_class": {"type": "string", "enum": ["A_OBSERVADO", "B_PRIMARIO", "C_PUBLICADO", "D_INTERNO", "E_INFERIDO"]},
          "description": {"type": "string"},
          "source_ref": {"type": "string"},
          "supports": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "horizons": {
      "type": "object",
      "additionalProperties": false,
      "required": ["now", "next", "later"],
      "properties": {
        "now": {"type": "array", "maxItems": 1, "items": {"type": "string"}},
        "next": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "later": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "next_action": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action_id", "instruction", "completion_criterion", "evidence_required", "authority"],
          "properties": {
            "action_id": {"type": "string"},
            "instruction": {"type": "string"},
            "completion_criterion": {"type": "string"},
            "evidence_required": {"type": "array", "items": {"type": "string"}},
            "authority": {"type": "string", "enum": ["DETERMINISTICO", "INTERPRETATIVO", "EXIGE_HUMANO", "NAO_DETERMINADO"]}
          }
        }
      ]
    },
    "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
    "projection": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "type": {"type": "string", "enum": ["mapa_operacional", "agora_proximo_depois", "status_terminal", "prisma_7d"]},
        "artifact_path": {"type": ["string", "null"]},
        "state": {"type": "string", "enum": ["planned", "created", "validated", "rendered", "print_inspected", "BLOCKED"]}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_valid", "wip_valid", "dependencies_valid", "evidence_valid", "result"],
      "properties": {
        "schema_valid": {"type": "boolean"},
        "wip_valid": {"type": "boolean"},
        "dependencies_valid": {"type": "boolean"},
        "evidence_valid": {"type": "boolean"},
        "result": {"type": "string", "enum": ["PASS", "BLOCKED"]}
      }
    }
  }
}
