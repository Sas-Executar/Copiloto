{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:prism-status-report:v4",
  "title": "Prism Status Report V4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "epic",
    "kpis",
    "calendar",
    "deliverables"
  ],
  "$defs": {
    "shortLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 72
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 190
    },
    "track": {
      "type": "string",
      "minLength": 1,
      "maxLength": 14
    }
  },
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epic_number",
        "epic_state",
        "eyebrow_top",
        "period_short"
      ],
      "properties": {
        "epic_number": {
          "type": "string",
          "maxLength": 4
        },
        "epic_state": {
          "$ref": "#/$defs/shortLabel"
        },
        "eyebrow_top": {
          "type": "string",
          "maxLength": 48
        },
        "period_short": {
          "type": "string",
          "maxLength": 24
        }
      }
    },
    "epic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "progress_pct",
        "eyebrow",
        "title",
        "description",
        "intent"
      ],
      "properties": {
        "progress_pct": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "eyebrow": {
          "$ref": "#/$defs/shortLabel"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 92
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220
        },
        "intent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "title",
            "text"
          ],
          "properties": {
            "label": {
              "$ref": "#/$defs/shortLabel"
            },
            "title": {
              "type": "string",
              "maxLength": 86
            },
            "text": {
              "type": "string",
              "maxLength": 170
            }
          }
        }
      }
    },
    "kpis": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "value",
          "caption"
        ],
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 18
          },
          "value": {
            "type": "string",
            "maxLength": 12
          },
          "caption": {
            "type": "string",
            "maxLength": 32
          }
        }
      }
    },
    "calendar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eyebrow",
        "title",
        "week_id",
        "period",
        "days"
      ],
      "properties": {
        "eyebrow": {
          "$ref": "#/$defs/shortLabel"
        },
        "title": {
          "type": "string",
          "maxLength": 36
        },
        "week_id": {
          "type": "string",
          "maxLength": 8
        },
        "period": {
          "type": "string",
          "maxLength": 24
        },
        "days": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "number",
              "weekday",
              "date",
              "title",
              "focus",
              "tracks"
            ],
            "properties": {
              "number": {
                "type": "string",
                "maxLength": 3
              },
              "weekday": {
                "type": "string",
                "maxLength": 4
              },
              "date": {
                "type": "string",
                "maxLength": 8
              },
              "title": {
                "type": "string",
                "maxLength": 42
              },
              "focus": {
                "type": "string",
                "maxLength": 92
              },
              "tracks": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "$ref": "#/$defs/track"
                }
              }
            }
          }
        }
      }
    },
    "deliverables": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eyebrow",
        "title",
        "meta",
        "hero",
        "items",
        "next",
        "trace"
      ],
      "properties": {
        "eyebrow": {
          "$ref": "#/$defs/shortLabel"
        },
        "title": {
          "type": "string",
          "maxLength": 44
        },
        "meta": {
          "type": "string",
          "maxLength": 30
        },
        "hero": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tag",
            "title",
            "description",
            "result_label",
            "result_value"
          ],
          "properties": {
            "tag": {
              "type": "string",
              "maxLength": 28
            },
            "title": {
              "type": "string",
              "maxLength": 64
            },
            "description": {
              "type": "string",
              "maxLength": 210
            },
            "result_label": {
              "type": "string",
              "maxLength": 24
            },
            "result_value": {
              "type": "string",
              "maxLength": 40
            }
          }
        },
        "items": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "description",
              "status"
            ],
            "properties": {
              "title": {
                "type": "string",
                "maxLength": 38
              },
              "description": {
                "type": "string",
                "maxLength": 100
              },
              "status": {
                "type": "string",
                "maxLength": 30
              }
            }
          }
        },
        "next": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "value"
          ],
          "properties": {
            "label": {
              "type": "string",
              "maxLength": 24
            },
            "value": {
              "type": "string",
              "maxLength": 38
            }
          }
        },
        "trace": {
          "type": "string",
          "maxLength": 120
        }
      }
    }
  }
}
